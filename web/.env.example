NODE_ENV="development"
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://user:password@host:5432/db?sslmode=require"
# Optional aliases from Vercel Storage (Prisma Postgres / Postgres integrations):
# STORAGE_PRISMA_DATABASE_URL="..."
# STORAGE_POSTGRES_URL="..."
# POSTGRES_PRISMA_URL="..."
# POSTGRES_URL_NON_POOLING="..."
# POSTGRES_URL="..."
AUTH_SECRET="replace_with_a_long_random_secret"
AUTH_GOOGLE_ID="google-oauth-client-id"
AUTH_GOOGLE_SECRET="google-oauth-client-secret"
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4.1-mini"
PYTHON_BIN="../ML/venv/bin/python"
PYTHON_BRIDGE_PATH="../ML/integration_bridge.py"
PYTHON_BRIDGE_TIMEOUT_MS="480000"
STAGE1_MODEL_ARTIFACT="../ML/outputs/stage1_biomarker_simulation_full/stage1_biomarker_models.joblib"
STAGE1_METRICS_PATH="../ML/outputs/stage1_biomarker_simulation_full/stage1_validation_summary.csv"
STAGE2_MODEL_DIR="../ML/outputs/models"
UNCERTAINTY_A="0.45"
UNCERTAINTY_B="0.35"
UNCERTAINTY_C="0.2"
UNCERTAINTY_LAMBDA="2"
UNCERTAINTY_HORIZON="sqrt"
UPLOAD_DIR="uploads"
NEXT_PUBLIC_APP_NAME="Medical Future Pipeline"
